# Piloto AWS EC2 — copie para .env.aws-pilot (não commitar).
# Gerado automaticamente por scripts/aws-deploy-archlens-ec2.sh se ausente.

DOMAIN=54-94-52-89.sslip.io
APP_URL=http://54-94-52-89.sslip.io
KEYCLOAK_PUBLIC_URL=http://54-94-52-89.sslip.io/auth
KEYCLOAK_ISSUER_URL=http://54-94-52-89.sslip.io/auth/realms/archlens

POSTGRES_PASSWORD=alterar
RABBITMQ_USERNAME=archlens
RABBITMQ_PASSWORD=alterar
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=alterar
KEYCLOAK_BFF_CLIENT_SECRET=alterar

# Piloto consultoria — quotas desligadas para demo repetível
ARCHLENS_ENFORCE_QUOTAS=false

# LLM / embeddings (consultoria real: defina OPENAI_API_KEY e rode deploy — auto-configura openai)
EMBEDDING_PROVIDER=local
ARCHLENS_LLM_PROVIDER=local
OPENAI_API_KEY=
# ARCHLENS_LLM_OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# White-label (opcional)
ARCHLENS_REPORT_BRAND_NAME=ArchLens AI
ARCHLENS_REPORT_LOGO_URL=
NEXT_PUBLIC_APP_NAME=ArchLens AI
NEXT_PUBLIC_APP_LOGO_URL=
NEXT_PUBLIC_PRIMARY_COLOR=#2563eb
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_SUPPORT_URL=mailto:consultoria@exemplo.com
